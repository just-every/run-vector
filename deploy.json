{
  "version": 1,
  "platforms": [
    "workers",
    "container"
  ],
  "container": {
    "engine": "workerd"
  },
  "project": "just-every/vector-projects",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "r2": [
    {
      "binding": "FILES"
    }
  ],
  "durableObjects": [
    {
      "binding": "RESTORE_COORDINATOR",
      "className": "VectorRestoreCoordinator",
      "storage": "sqlite"
    }
  ],
  "crons": [
    "* * * * *"
  ],
  "originVar": "APP_ORIGIN",
  "vars": {
    "MAIL_PROVIDER": "sendgrid",
    "MAIL_MODE": "production",
    "SEED_SAMPLE_DATA": "false",
    "NOTIFICATION_EMAIL_ENABLED": "true"
  },
  "secrets": [
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "SENDGRID_API_KEY"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    }
  ]
}
