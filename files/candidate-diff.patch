@@ -0,0 +1,14 @@
+import { loadAuthority, authorityFence } from '../roles/authority'
+import { decide, decisionInputs, type Question } from '../roles/policy'
+import { SettingsError } from '../settings/repository'
+
+/** FIELD-001: a team's fields follow the role matrix's "team setting" row
+ * (ROLE-001, ROLE-009), decided on the actor's current record. The returned
+ * fence requires the same role and team permission inside the write. */
+export async function fieldManagementFence(db: D1Database, actor: string, teamId: string) {
+  const authority = await loadAuthority(db, actor, [teamId])
+  const question: Question = { row: 'custom-fields.team', teams: [teamId] }
+  if (!authority || decide(authority, question) !== 'allow')
+    throw new SettingsError('forbidden', 'Your current role cannot change this team’s fields.', 403)
+  return authorityFence(actor, authority, decisionInputs(authority, question))
+}
diff --git a/src/core/features/custom-fields/copy.ts b/src/core/features/custom-fields/copy.ts
new file mode 100644
index 0000000..f240a17
--- /dev/null
+++ b/src/core/features/custom-fields/copy.ts
@@ -0,0 +1,30 @@
+import type { DroppedCopyValue } from '../issue-copy/schema'
+import { namedDefinitions, type FieldValues } from './validation'
+
+/** ISSUE-023 for typed team fields: a copy that stays in the field's team keeps the
+ * same definition and option identity; a copy into another team drops the value
+ * and reports it, since that team has no such field. Untyped legacy keys keep
+ * their workspace-wide identity mapping. */
+export async function mapCopiedFieldValues(db: D1Database, identifier: string, values: FieldValues, teamId: string) {
+  const { definitions, options } = await namedDefinitions(db, Object.keys(values))
+  const mapped: FieldValues = {}, checked: Record<string, string> = {}
+  const mappings: { from: string; to: string | null }[] = [], dropped: DroppedCopyValue[] = []
+  for (const [key, value] of Object.entries(values)) {
+    const definition = definitions.find(row => row.id === key)
+    const option = definition && options.find(row => row.field_id === key && row.id === value)
+    if (!definition || (definition.team_id === teamId && option)) {
+      mapped[key] = value
+      if (option) checked[key] = option.id
+      mappings.push({ from: key, to: key })
+      continue
+    }
+    mappings.push({ from: key, to: null })
+    dropped.push({
+      identifier, field: `customFields.${key}`, value,
+      reason: definition.team_id === teamId
+        ? `The original ${definition.name} option is unavailable.`
+        : `The destination team has no ${definition.name} field; ${option ? option.name : 'its value'} stays on the original issue only.`,
+    })
+  }
+  return { values: mapped, checked, mappings, dropped }
+}
diff --git a/src/core/features/custom-fields/definitions.ts b/src/core/features/custom-fields/definitions.ts
new file mode 100644
index 0000000..3aceaa3
--- /dev/null
+++ b/src/core/features/custom-fields/definitions.ts
@@ -0,0 +1,69 @@
+import { createUlid } from '../../shared/ids'
+import { administrationContext, audit, commit, guard, SettingsError, type AdministrationContext } from '../administration/transaction'
+import { fieldManagementFence } from './authority'
+import { planOptions } from './options'
+import type { FieldCreateInput, FieldUpdateInput } from './schema'
+
+type Stored = { id: string; name: string; description: string; type: string; version: number }
+const insertOption = 'INSERT INTO custom_field_options(id,field_id,name,position,created_at,updated_at) VALUES(?,?,?,?,?,?)'
+
+/** The team as the reader sees it now: hidden and other-workspace teams are absent. */
+async function activeTeam(ctx: AdministrationContext, teamId: string) {
+  const team = await ctx.db.prepare('SELECT archived_at FROM teams WHERE id=? AND workspace_id=?').bind(teamId, ctx.workspace).first<{ archived_at: string | null }>()
+  if (!team) throw new SettingsError('not_found', 'Team is unavailable.', 404)
+  if (team.archived_at) throw new SettingsError('team_archived', 'Unarchive this team before changing its fields.', 409)
+}
+
+/** A name is unique in its team, whatever its letter case; the unique index decides races. */
+async function availableName(ctx: AdministrationContext, teamId: string, name: string, except: string | null = null) {
+  if (await ctx.db.prepare('SELECT 1 FROM main.custom_field_definitions WHERE team_id=? AND name=? COLLATE NOCASE AND id IS NOT ?').bind(teamId, name, except).first())
+    throw new SettingsError('field_name_taken', `This team already has a field named ${name}.`, 409)
+}
+
+export async function createField(db: D1Database, actor: string, teamId: string, input: FieldCreateInput) {
+  const ctx = await administrationContext(db, actor)
+  const fence = await fieldManagementFence(ctx.db, actor, teamId)
+  await activeTeam(ctx, teamId)
+  await availableName(ctx, teamId, input.name)
+  const id = createUlid(new Date(ctx.at))
+  const options = input.options.map((option, position) => ({ id: createUlid(new Date(ctx.at)), name: option.name, position }))
+  await commit(ctx, [
+    guard(ctx.db, fence.sql, ...fence.values),
+    guard(ctx.db, 'EXISTS(SELECT 1 FROM main.teams WHERE id=? AND workspace_id=? AND archived_at IS NULL)', teamId, ctx.workspace),
+    ctx.db.prepare('INSERT INTO custom_field_definitions(id,workspace_id,team_id,name,description,type,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?)')
+      .bind(id, ctx.workspace, teamId, input.name, input.description, input.type, ctx.at, ctx.at),
+    ...options.map(option => ctx.db.prepare(insertOption).bind(option.id, id, option.name, option.position, ctx.at, ctx.at)),
+    ...audit(ctx, 'custom_field.created', id, input.name, null,
+      { teamId, name: input.name, description: input.description, type: input.type, options: options.map(({ id, name }) => ({ id, name })) }),
+  ])
+  return id
+}
+
+/** Renames the field or its options, edits its description or adds options. No stored
+ * issue value changes: values name option identities, never option names. */
+export async function updateField(db: D1Database, actor: string, teamId: string, fieldId: string, input: FieldUpdateInput) {
+  const ctx = await administrationContext(db, actor)
+  const fence = await fieldManagementFence(ctx.db, actor, teamId)
+  await activeTeam(ctx, teamId)
+  const field = await ctx.db.prepare('SELECT id,name,description,type,version FROM custom_field_definitions WHERE id=? AND team_id=?').bind(fieldId, teamId).first<Stored>()
+  if (!field) throw new SettingsError('not_found', 'Field is unavailable.', 404)
+  if (field.version !== input.expectedVersion) throw new SettingsError('stale_field', 'This field changed. Reload it before saving again.', 409)
+  const stored = (await ctx.db.prepare('SELECT id,name,position FROM custom_field_options WHERE field_id=? ORDER BY position,id').bind(fieldId)
+    .all<{ id: string; name: string; position: number }>()).results
+  const options = input.options ? planOptions(stored, input.options) : { renamed: [], added: [] }
+  const name = input.name ?? field.name, description = input.description ?? field.description
+  if (name !== field.name) await availableName(ctx, teamId, name, fieldId)
+  if (name === field.name && description === field.description && !options.renamed.length && !options.added.length) return
+  const added = options.added.map(option => ({ ...option, id: createUlid(new Date(ctx.at)) }))
+  await commit(ctx, [
+    guard(ctx.db, fence.sql, ...fence.values),
+    guard(ctx.db, `EXISTS(SELECT 1 FROM main.custom_field_definitions d JOIN main.teams t ON t.id=d.team_id
+      WHERE d.id=? AND d.team_id=? AND d.version=? AND t.archived_at IS NULL)`, fieldId, teamId, field.version),
+    ctx.db.prepare('UPDATE custom_field_definitions SET name=?,description=?,version=version+1,updated_at=? WHERE id=?').bind(name, description, ctx.at, fieldId),
+    ...options.renamed.map(option => ctx.db.prepare('UPDATE custom_field_options SET name=?,updated_at=? WHERE id=? AND field_id=?').bind(option.to, ctx.at, option.id, fieldId)),
+    ...added.map(option => ctx.db.prepare(insertOption).bind(option.id, fieldId, option.name, option.position, ctx.at, ctx.at)),
+    ...audit(ctx, 'custom_field.updated', fieldId, name,
+      { name: field.name, description: field.description, version: field.version, options: options.renamed.map(({ id, from }) => ({ id, name: from })) },
+      { name, description, version: field.version + 1, options: [...options.renamed.map(({ id, to }) => ({ id, name: to })), ...added.map(({ id, name }) => ({ id, name }))] }),
+  ])
+}
diff --git a/src/core/features/custom-fields/options.ts b/src/core/features/custom-fields/options.ts
new file mode 100644
index 0000000..df6a13b
--- /dev/null
+++ b/src/core/features/custom-fields/options.ts
@@ -0,0 +1,17 @@
+import { SettingsError } from '../settings/repository'
+
+type Stored = { id: string; name: string; position: number }
+
+/** Option identity is permanent: existing options keep their id and order, a
+ * rename changes only the name, and new options go last. Removing, archiving and
+ * reordering options are not offered yet. */
+export function planOptions(stored: Stored[], requested: { id?: string; name: string }[]) {
+  const kept = requested.slice(0, stored.length)
+  if (kept.length !== stored.length || kept.some((option, index) => option.id !== stored[index]!.id) || requested.slice(stored.length).some(option => option.id))
+    throw new SettingsError('invalid_request', 'Keep every existing option in its current order and add new options last.', 400)
+  const next = Math.max(-1, ...stored.map(option => option.position)) + 1
+  return {
+    renamed: stored.flatMap((option, index) => kept[index]!.name === option.name ? [] : [{ id: option.id, from: option.name, to: kept[index]!.name }]),
+    added: requested.slice(stored.length).map((option, index) => ({ name: option.name, position: next + index })),
+  }
+}
diff --git a/src/core/features/custom-fields/read.ts b/src/core/features/custom-fields/read.ts
new file mode 100644
index 0000000..00011a2
--- /dev/null
+++ b/src/core/features/custom-fields/read.ts
@@ -0,0 +1,28 @@
+import { customFieldSchema, type CustomField } from './schema'
+
+type Row = { id: string; team_id: string; name: string; description: string; type: string; version: number; option_id: string | null; option_name: string | null }
+const columns = 'd.id,d.team_id,d.name,d.description,d.type,d.version,o.id AS option_id,o.name AS option_name'
+const order = 'ORDER BY d.name COLLATE NOCASE,d.id,o.position,o.id'
+
+/** Every visible team's fields. Unqualified tables follow the reader's current
+ * team visibility (ROLE-002, ROLE-003), so a hidden team's fields never appear. */
+export function teamFieldsStatement(db: D1Database, workspaceId: string) {
+  return db.prepare(`SELECT ${columns} FROM custom_field_definitions d JOIN teams t ON t.id=d.team_id
+    LEFT JOIN custom_field_options o ON o.field_id=d.id WHERE t.workspace_id=? ${order}`).bind(workspaceId)
+}
+
+/** The fields that apply to one issue: those of its current team. */
+export function issueFieldsStatement(db: D1Database, issueId: string) {
+  return db.prepare(`SELECT ${columns} FROM issues i JOIN custom_field_definitions d ON d.team_id=i.team_id
+    LEFT JOIN custom_field_options o ON o.field_id=d.id WHERE i.id=? ${order}`).bind(issueId)
+}
+
+export function fieldProjection(rows: readonly unknown[]): CustomField[] {
+  const fields = new Map<string, { id: string; teamId: string; name: string; description: string; type: string; version: number; options: { id: string; name: string }[] }>()
+  for (const row of rows as Row[]) {
+    const field = fields.get(row.id) ?? { id: row.id, teamId: row.team_id, name: row.name, description: row.description, type: row.type, version: row.version, options: [] }
+    if (row.option_id !== null) field.options.push({ id: row.option_id, name: String(row.option_name) })
+    fields.set(row.id, field)
+  }
+  return [...fields.values()].map(field => customFieldSchema.parse(field))
+}
diff --git a/src/core/features/custom-fields/routes.ts b/src/core/features/custom-fields/routes.ts
new file mode 100644
index 0000000..9cbe9da
--- /dev/null
+++ b/src/core/features/custom-fields/routes.ts
@@ -0,0 +1,30 @@
+import type { Context, Hono } from 'hono'
+import type { z } from 'zod'
+import type { AppEnvironment } from '../../app/bindings'
+import { readRequestJson } from '../../app/input'
+import { readAdministration } from '../administration/read'
+import { administrationId } from '../administration/schema'
+import { SettingsError } from '../settings/repository'
+import { createField, updateField } from './definitions'
+import { fieldCreateSchema, fieldUpdateSchema } from './schema'
+
+/** A team's fields in Settings (FIELD-001). Each door answers with the refreshed
+ * Settings model, like the team's other configuration doors. */
+export function addCustomFieldRoutes(app: Hono<AppEnvironment>) {
+  const action = <T extends z.ZodType>(schema: T, run: (c: Context<AppEnvironment>, body: z.output<T>) => Promise<unknown>) =>
+    async (c: Context<AppEnvironment>) => {
+      if (Object.values(c.req.param()).some(id => !administrationId.safeParse(id).success)) return c.json({ error: 'invalid_request' }, 400)
+      const parsed = schema.safeParse(await readRequestJson(c.req.raw))
+      if (!parsed.success) return c.json({ error: 'invalid_request', message: parsed.error.issues.map(issue => `${issue.path.join('.') || 'Input'}: ${issue.message}`).join(' '), issues: parsed.error.issues }, 400)
+      try {
+        await run(c, parsed.data)
+        return c.json(await readAdministration(c.env.DB, c.get('operatorId')))
+      } catch (error) {
+        if (error instanceof SettingsError) return c.json({ error: error.code, message: error.message }, error.status)
+        throw error
+      }
+    }
+  app.post('/settings/teams/:id/custom-fields', action(fieldCreateSchema, (c, body) => createField(c.env.DB, c.get('operatorId'), c.req.param('id')!, body)))
+  app.patch('/settings/teams/:id/custom-fields/:fieldId', action(fieldUpdateSchema, (c, body) =>
+    updateField(c.env.DB, c.get('operatorId'), c.req.param('id')!, c.req.param('fieldId')!, body)))
+}
