{
  "schema": 1,
  "title": "Vector",
  "groups": [
    {
      "id": "workspace",
      "label": "Your workspace"
    },
    {
      "id": "mail",
      "label": "Email delivery"
    }
  ],
  "fields": [
    {
      "name": "FIRST_OWNER_EMAIL",
      "label": "Owner email",
      "kind": "email",
      "required": true,
      "group": "workspace",
      "prefill": "account-email"
    },
    {
      "name": "FIRST_OWNER_NAME",
      "label": "Owner name",
      "kind": "text",
      "required": true,
      "group": "workspace",
      "default": "Owner"
    },
    {
      "name": "WORKSPACE_NAME",
      "label": "Workspace name",
      "kind": "text",
      "required": true,
      "group": "workspace",
      "default": "My workspace"
    },
    {
      "name": "WORKSPACE_TIMEZONE",
      "label": "Workspace timezone",
      "kind": "timezone",
      "required": true,
      "group": "workspace",
      "default": "UTC"
    },
    {
      "name": "DEFAULT_TEAM_NAME",
      "label": "Team name",
      "kind": "text",
      "required": true,
      "group": "workspace",
      "default": "Delivery"
    },
    {
      "name": "DEFAULT_TEAM_PREFIX",
      "label": "Team prefix",
      "kind": "text",
      "required": true,
      "group": "workspace",
      "default": "VEC"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "workspace",
      "help": "Generated installation secret protects sign-in sessions and links. Keep it private."
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "generate": "hex",
      "group": "workspace",
      "input": "managed",
      "help": "Generated token protects the initial owner claim. Keep it private."
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Mail provider",
      "kind": "select",
      "required": true,
      "default": "local-outbox",
      "options": [
        {
          "value": "local-outbox",
          "label": "Local development outbox"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        },
        {
          "value": "resend",
          "label": "Resend"
        },
        {
          "value": "rer",
          "label": "RER managed mail"
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender address",
      "kind": "text",
      "required": false,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "kind": "url",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "group": "mail"
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Mail API key",
      "kind": "secret",
      "input": "entered",
      "ownerVisible": true,
      "required": false,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        }
      ],
      "group": "mail",
      "help": "Optional until a delivery provider is selected; enter its API key or managed relay credential."
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "default": "",
      "help": "Optional Auth install. Leave empty to use email links."
    }
  ],
  "steps": [
    {
      "type": "owner-claim",
      "mode": "signed",
      "emailField": "FIRST_OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN",
      "path": "/auth/owner-claim"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ],
  "business": {
    "settings": 1,
    "values": [
      "display_name"
    ]
  }
}
