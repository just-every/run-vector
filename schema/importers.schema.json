{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runeditrun.com/schemas/vector/importers-v1.schema.json",
  "title": "Vector importer support catalogue (plain evidence)",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "importers"
  ],
  "properties": {
    "$schema": {
      "const": "./schema/importers.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "importers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/documentedImporter"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "documentedImporter": {
      "type": "object",
      "required": [
        "incumbent",
        "product",
        "status",
        "evidence"
      ],
      "properties": {
        "incumbent": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "documented format"
        },
        "evidence": {
          "type": "object",
          "required": [
            "link",
            "validation",
            "realExport"
          ],
          "properties": {
            "link": {
              "type": "string",
              "minLength": 1
            },
            "validation": {
              "const": "synthetic-only"
            },
            "realExport": {
              "const": "not-supplied"
            }
          },
          "additionalProperties": false
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testedScale": {
          "type": "object",
          "required": [
            "issues",
            "method"
          ],
          "properties": {
            "issues": {
              "type": "integer",
              "minimum": 1
            },
            "method": {
              "const": "deterministic generator"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
