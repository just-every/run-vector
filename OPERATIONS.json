{
  "version": 2,
  "project": "just-every/vector-projects",
  "runtime": {
    "requirements": [
      {
        "name": "node",
        "version": "22.20.0"
      },
      {
        "name": "pnpm",
        "version": "10.12.4"
      },
      {
        "name": "Cloudflare Worker / D1 / R2",
        "version": "compatibility 2026-09-08; local and disposable workers.dev deployment"
      }
    ]
  },
  "requiredEnvironment": [
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_API_TOKEN",
    "APP_ORIGIN",
    "SESSION_SECRET",
    "SENDGRID_API_KEY",
    "FIRST_OWNER_EMAIL",
    "FIRST_OWNER_NAME",
    "WORKSPACE_NAME",
    "WORKSPACE_TIMEZONE",
    "DEFAULT_TEAM_NAME",
    "DEFAULT_TEAM_PREFIX",
    "MAIL_FROM",
    "CF_THROWAWAY_ACCOUNT_ID",
    "CF_THROWAWAY_API_TOKEN",
    "RER_DEPLOY_ARTIFACT",
    "RER_DEPLOY_ARTIFACT_SHA256",
    "RER_DEPLOY_SOURCE_SHA",
    "RER_DEPLOY_RUN_ID",
    "RER_DEPLOY_RUN_ATTEMPT",
    "RER_DEPLOY_RECEIPT",
    "RER_DEPLOY_PLAN",
    "MAIL_API_KEY"
  ],
  "documentation": {
    "document": "OPERATIONS.md"
  },
  "acceptance": {
    "document": "ACCEPTANCE.md"
  },
  "commands": {
    "install": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "install"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Installs frozen dependencies only."
    },
    "dev": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "dev"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Serves the local application with HMR and development outbox."
    },
    "build": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "build"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Runs the shared build command; see SEED-COMMAND-CONTRACT.md."
    },
    "setup": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "setup"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Prepares the local owner, private settings and data; stops its temporary app."
    },
    "deploy": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "deploy"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Builds and deploys to the explicit owner account; dry run sends no provider request."
    },
    "health": {
      "argv": [
        "pnpm",
        "run",
        "deploy:health"
      ],
      "inputs": [
        "package.json",
        "scripts/owner.mjs",
        "deploy.json"
      ],
      "effects": "Checks the same durable owner deployment."
    },
    "artifact-prepare": {
      "argv": [
        "pnpm",
        "run",
        "deploy:prepare"
      ],
      "inputs": [
        "package.json",
        "scripts/deployment/prepare.mjs"
      ],
      "effects": "Prepares an inert build artifact in credential-free isolation."
    },
    "artifact-setup": {
      "argv": [
        "pnpm",
        "run",
        "artifact:setup"
      ],
      "inputs": [
        "package.json",
        "scripts/deployment/controller.mjs"
      ],
      "effects": "Provisions from a reviewed isolated artifact plan."
    },
    "artifact-deploy": {
      "argv": [
        "pnpm",
        "run",
        "artifact:deploy"
      ],
      "inputs": [
        "package.json",
        "scripts/deployment/controller.mjs"
      ],
      "effects": "Reconciles a reviewed isolated artifact plan."
    },
    "artifact-health": {
      "argv": [
        "pnpm",
        "run",
        "artifact:health"
      ],
      "inputs": [
        "package.json",
        "scripts/deployment/controller.mjs"
      ],
      "effects": "Checks the isolated artifact deployment."
    },
    "verify": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "verify"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Runs the shared verify command; see SEED-COMMAND-CONTRACT.md."
    },
    "preview": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "preview"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Runs the shared preview command; see SEED-COMMAND-CONTRACT.md."
    },
    "reset": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "reset"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Removes only confirmed inventoried local data and settings."
    },
    "export": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "export"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Writes an owner-only supported local archive."
    },
    "import": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "import"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Validates and atomically restores an archive into empty local storage."
    },
    "release": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "release"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Runs the shared release command; see SEED-COMMAND-CONTRACT.md."
    },
    "outbox": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "outbox"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Runs the shared outbox command; see SEED-COMMAND-CONTRACT.md."
    },
    "doctor": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "doctor"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Runs the shared doctor command; see SEED-COMMAND-CONTRACT.md."
    },
    "describe": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "describe"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Runs the shared describe command; see SEED-COMMAND-CONTRACT.md."
    },
    "check": {
      "argv": [
        "node",
        "scripts/rer.mjs",
        "check"
      ],
      "inputs": [
        "package.json",
        "scripts/rer.mjs",
        "scripts/installer/local.mjs",
        "rer-setup.json"
      ],
      "effects": "Runs the shared check command; see SEED-COMMAND-CONTRACT.md."
    }
  },
  "configuration": {
    "module": "scripts/operations-config.mjs"
  },
  "environmentSources": {
    "CLOUDFLARE_ACCOUNT_ID": "See DEPLOY.md",
    "CLOUDFLARE_API_TOKEN": "See DEPLOY.md",
    "APP_ORIGIN": "See DEPLOY.md",
    "SESSION_SECRET": "See DEPLOY.md",
    "SENDGRID_API_KEY": "See DEPLOY.md",
    "FIRST_OWNER_EMAIL": "See DEPLOY.md",
    "FIRST_OWNER_NAME": "See DEPLOY.md",
    "WORKSPACE_NAME": "See DEPLOY.md",
    "WORKSPACE_TIMEZONE": "See DEPLOY.md",
    "DEFAULT_TEAM_NAME": "See DEPLOY.md",
    "DEFAULT_TEAM_PREFIX": "See DEPLOY.md",
    "MAIL_FROM": "See DEPLOY.md",
    "CF_THROWAWAY_ACCOUNT_ID": "See DEPLOY.md",
    "CF_THROWAWAY_API_TOKEN": "See DEPLOY.md",
    "RER_DEPLOY_ARTIFACT": "See DEPLOY.md",
    "RER_DEPLOY_ARTIFACT_SHA256": "See DEPLOY.md",
    "RER_DEPLOY_SOURCE_SHA": "See DEPLOY.md",
    "RER_DEPLOY_RUN_ID": "See DEPLOY.md",
    "RER_DEPLOY_RUN_ATTEMPT": "See DEPLOY.md",
    "RER_DEPLOY_RECEIPT": "See DEPLOY.md",
    "RER_DEPLOY_PLAN": "See DEPLOY.md",
    "MAIL_API_KEY": "See DEPLOY.md"
  },
  "loops": [
    {
      "id": "worker",
      "type": "worker",
      "enabled": true,
      "required": true
    }
  ],
  "seedContract": {
    "version": 1,
    "profile": "first-party",
    "adapter": "scripts/installer/local.mjs"
  }
}
