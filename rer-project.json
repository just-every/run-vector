{
  "schema": 1,
  "projectId": "just-every/vector-projects",
  "name": "Vector",
  "sourceRepository": "https://github.com/just-every/run-vector",
  "license": "MIT",
  "deployment": {
    "target": "cloudflare-workers",
    "artifactFile": "rer-worker-artifact.json"
  },
  "operations": {
    "setup": "bash scripts/delivery/setup-build.sh",
    "build": "export PATH=\"$PWD/.rer-tools/node_modules/.bin:$PATH\" && pnpm run build",
    "verify": "export PATH=\"$PWD/.rer-tools/node_modules/.bin:$PATH\" && pnpm run verify",
    "artifact": "export PATH=\"$PWD/.rer-tools/node_modules/.bin:$PATH\" && node scripts/build-delivery-artifact.mjs",
    "recovery": "Preserve private deployment receipts and the D1 migration ledger. Restore into an empty database and FILES bucket; re-enter secrets, review operator access and release the installation effect hold. Never replay historical mail or webhooks."
  },
  "verification": {
    "sensitivePaths": [
      "src/core/features/auth/**",
      "src/core/features/data/**",
      "src/core/features/bootstrap/**",
      "src/core/editor/**",
      "vendor/base/operator-auth/**",
      "vendor/base/owner-claim/**",
      "vendor/base/editor/**",
      "vendor/base/portability/**",
      "scripts/installer/**",
      "scripts/delivery/**",
      "rer-setup.json",
      ".github/workflows/rer-managed.yml",
      "src/core/features/integrations/**",
      "vendor/base/integrations/**",
      "vendor/base/import-kit/**",
      "package.json",
      "pnpm-lock.yaml"
    ],
    "migrationDirectories": [
      "migrations/core"
    ],
    "guidanceFiles": [
      "AGENTS.md",
      "CONTRACT.md",
      "OPERATIONS.md"
    ],
    "testPatterns": [
      "tests/**/*.test.ts",
      "tests/**/*.test.mjs",
      "tests/e2e/*.mjs",
      "scripts/deployment/tests/*.test.mjs"
    ]
  },
  "setup": {
    "path": "rer-setup.json",
    "sha256": "6b6f0c3fb294bc62ab5add3b163f01f230ee9eebb4f71469ff23c0d99f2a0107"
  }
}
