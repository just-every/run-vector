{
  "name": "vector-local",
  "main": "./src/core/app/worker.ts",
  "compatibility_date": "2026-09-08",
  "durable_objects": {"bindings":[{"name":"RESTORE_COORDINATOR","class_name":"VectorRestoreCoordinator"}]},
  "migrations": [{"tag":"vector-http-restore-v1","new_sqlite_classes":["VectorRestoreCoordinator"]}],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vector-local",
      "migrations_dir": "migrations/core",
      "database_id": "vector-local-only"
    }
  ],
  "vars": {
    "SEED_SAMPLE_DATA": "true",
    "APP_ORIGIN": "http://127.0.0.1:15920",
    "MAIL_MODE": "local-outbox"
  },
  "triggers": { "crons": ["* * * * *"] },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "vector-local-files"
    }
  ]
}
